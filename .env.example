# Telegram Alerting
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Server & Backup Paths
BACKUP_SOURCE_DIR=/path/to/source
BACKUP_DEST_DIR=/path/to/destination
REMOTE_SERVER_IP=192.168.1.100
REMOTE_USER=admin

# Exchange / Monitoring Thresholds
TEMP_WARNING_THRESHOLD=75
STORAGE_THRESHOLD_PERCENT=85
